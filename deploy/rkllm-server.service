[Unit]
Description=Lociant RKLLM server (local NPU inference, OpenAI-compatible)
After=network-online.target systemd-modules-load.service
Wants=network-online.target

[Service]
Type=simple
User=lhx
Group=lhx
# flask_server.py loads lib/librkllmrt.so relative to the working directory.
WorkingDirectory=/home/lhx/rknn-llm/rknn-llm/examples/rkllm_server_demo/rkllm_server
ExecStart=/home/lhx/rkllm-venv/bin/python flask_server.py --rkllm_model_path /home/lhx/qwen3.5-0.8b-w4a16-g128-opt0.rkllm --target_platform rk3576
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
