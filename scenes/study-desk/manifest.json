{
  "id": "study-desk",
  "name": "Study Desk",
  "version": "0.4.0",
  "description": "Automatic focus tracking via camera. Detects presence, accumulates focus time, logs breaks, and gently reminds you to rest.",
  "entry": "web/index.html",
  "permissions": ["camera"],
  "models": [{ "id": "yolov8n", "runtime": "ncnn", "required": true, "purpose": "object-detection" }],
  "triggers": [
    {
      "id": "person-present",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 0, "absent": false, "minConfidence": 0.45 },
      "forMs": 2000,
      "tool": "record_event",
      "arguments": { "sceneId": "study-desk", "type": "person.present", "level": "info" }
    },
    {
      "id": "person-away",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 0, "absent": true, "minConfidence": 0.45 },
      "forMs": 30000,
      "tool": "record_event",
      "arguments": { "sceneId": "study-desk", "type": "person.away", "level": "info" }
    },
    {
      "id": "focus-accum",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 0, "absent": false, "minConfidence": 0.45 },
      "forMs": 10000,
      "tool": "store_value",
      "arguments": { "namespace": "study-desk", "key": "focus_seconds", "value": 10 }
    },
    {
      "id": "break-count",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 0, "absent": true, "minConfidence": 0.45 },
      "forMs": 120000,
      "tool": "store_value",
      "arguments": { "namespace": "study-desk", "key": "break_count", "value": 1 }
    },
    {
      "id": "distraction-count",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 67, "absent": false, "minConfidence": 0.45 },
      "forMs": 5000,
      "tool": "store_value",
      "arguments": { "namespace": "study-desk", "key": "distraction_count", "value": 1 }
    },
    {
      "id": "break-long-remind",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 0, "absent": true, "minConfidence": 0.45 },
      "forMs": 300000,
      "tool": "notify_user",
      "arguments": { "title": "Still away?", "body": "5 minutes away. Time to come back?" }
    },
    {
      "id": "focus-long-remind",
      "source": "camera:yolov8n",
      "condition": { "type": "detection", "classId": 0, "absent": false, "minConfidence": 0.45 },
      "forMs": 2700000,
      "tool": "notify_user",
      "arguments": { "title": "Take a break!", "body": "45 minutes of focus. Get up, stretch, walk around." }
    }
  ]
}
